# ============================================================
# AMI HOSTLERS JAIPUR — backend settings
# Copy this file to .env and fill in your own values.
# ============================================================
PORT=5002
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ami_hostel?retryWrites=true&w=majority
JWT_SECRET=make_a_long_random_text

# Cloudinary (payment screenshots, complaint + visitor photos)
CLOUDINARY_CLOUD_NAME=
