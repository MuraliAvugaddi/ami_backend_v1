# Mess fee UPI
PAYMENT_UPI_ID=
PAYMENT_PAYEE_NAME=AMI HOSTLERS JAIPUR
PAYMENT_PAYEE_KEYWORD=AMI HOSTLERS
RECEIPT_BUSINESS_NAME=AMI HOSTLERS JAIPUR
